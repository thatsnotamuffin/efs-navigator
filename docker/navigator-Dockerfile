FROM python:3.12-slim

WORKDIR /app

# Install system dependencies  
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create mount point BEFORE switching users
RUN mkdir -p /mnt/data

# Create non-root user and set ownership
RUN groupadd -r navigator && useradd -r -g navigator navigator
RUN chown -R navigator:navigator /app

# Also give the user ownership of the mount point
RUN chown navigator:navigator /mnt/data

# Switch to non-root user LAST
USER navigator

# Expose port
EXPOSE 5000

# Health check with configurable port
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-5000}/health || exit 1
